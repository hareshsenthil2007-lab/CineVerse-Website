# CINEVERSE ENVIRONMENT VARIABLES

# Application Hosting URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TMDB API (Optional: If provided, fetches live metadata; otherwise defaults to seeded offline ledger)
NEXT_PUBLIC_TMDB_API_KEY=

# Supabase PostgreSQL Database (Optional: If omitted, Cineverse uses its built-in Data Access Layer)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
